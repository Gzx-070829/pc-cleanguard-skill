{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc-cleanguard.local/schemas/guard/action_request.schema.json",
  "title": "PC CleanGuard v0.5 ActionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "action_type", "targets", "parameters", "requested_effect", "requested_at", "agent_id", "agent_reason", "evidence_refs", "dry_run"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "action_type": {"type": "string", "minLength": 1},
    "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/action_target"}},
    "parameters": {"type": "object"},
    "requested_effect": {"type": "string", "minLength": 1},
    "requested_at": {"type": "string", "format": "date-time"},
    "agent_id": {"type": "string", "minLength": 1},
    "agent_reason": {"type": "string"},
    "evidence_refs": {"type": "array", "items": {}},
    "dry_run": {"type": "boolean"}
  },
  "$defs": {
    "action_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_type", "identifier", "path", "metadata", "observed_state"],
      "properties": {
        "target_type": {"type": "string", "minLength": 1},
        "identifier": {"type": "string", "minLength": 1},
        "path": {"type": ["string", "null"]},
        "metadata": {"type": "object"},
        "observed_state": {"type": "object"}
      }
    }
  }
}

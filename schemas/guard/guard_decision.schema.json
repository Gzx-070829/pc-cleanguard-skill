{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc-cleanguard.local/schemas/guard/guard_decision.schema.json",
  "title": "PC CleanGuard v0.5 GuardDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "request_id", "disposition", "risk_level", "requirements", "matched_rules", "blocked_reasons", "explanation", "decision_fingerprint", "execution_authorized", "generated_at", "action_fingerprint", "target_fingerprints", "requested_effect", "scope_snapshot", "preconditions_snapshot", "policy_version"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["ALLOW", "REQUIRE", "BLOCK"]},
    "risk_level": {"enum": ["L0", "L1", "L2", "L3", "L4", "L5"]},
    "requirements": {"type": "array", "items": {"enum": ["USER_CONFIRMATION", "BACKUP", "ROLLBACK_CONTRACT", "ROLLBACK_PLAN", "TARGET_REVALIDATION", "POSTCONDITION_VERIFY", "ADMIN_ACKNOWLEDGEMENT", "AUDIT", "EXPLICIT_HIGH_RISK_CONFIRMATION"]}, "uniqueItems": true},
    "matched_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "blocked_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "explanation": {"type": "string", "minLength": 1},
    "decision_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_authorized": {"const": false},
    "generated_at": {"type": "string", "format": "date-time"},
    "action_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_fingerprints": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "requested_effect": {"type": "string", "minLength": 1},
    "scope_snapshot": {"type": "object"},
    "preconditions_snapshot": {"type": "object"},
    "policy_version": {"type": "string", "minLength": 1}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc-cleanguard.local/schemas/guard/execution_contract.schema.json",
  "title": "PC CleanGuard v0.5 ExecutionContract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "decision_id", "action_fingerprint", "authorized_targets", "authorized_effect", "requirements_satisfied", "preconditions_snapshot", "expires_at", "execution_authorized", "rollback_id"],
  "properties": {
    "contract_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "action_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorized_targets": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "authorized_effect": {"type": "string", "minLength": 1},
    "requirements_satisfied": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "preconditions_snapshot": {"type": "object"},
    "expires_at": {"type": "string", "format": "date-time"},
    "execution_authorized": {"const": true},
    "rollback_id": {"type": ["string", "null"]}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc-cleanguard.local/schemas/guard/consent_grant.schema.json",
  "title": "PC CleanGuard v0.5 ConsentGrant",
  "type": "object",
  "additionalProperties": false,
  "required": ["consent_id", "decision_id", "action_fingerprint", "allowed_targets", "allowed_effect", "allowed_scope", "issued_at", "expires_at", "confirmation_level", "confirmation_source"],
  "properties": {
    "consent_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "action_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "allowed_targets": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "allowed_effect": {"type": "string", "minLength": 1},
    "allowed_scope": {"type": "object"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "confirmation_level": {"enum": ["STANDARD", "HIGH_RISK"]},
    "confirmation_source": {"type": "string", "minLength": 1}
  }
}

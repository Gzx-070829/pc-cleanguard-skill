{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc-cleanguard.example/schemas/reputation_record.schema.json",
  "title": "PC CleanGuard Reputation KB Record",
  "description": "Evidence for explanation, sorting, and risk提示 only. PR20 local seeds can never authorize deletion, uninstall, disablement, or execution.",
  "type": "object",
  "required": [
    "record_id",
    "software_name",
    "publisher",
    "aliases",
    "behavior_categories",
    "source_type",
    "source_name",
    "source_url",
    "source_date",
    "evidence_summary",
    "confidence",
    "jurisdiction",
    "language",
    "false_positive_risk",
    "review_status",
    "license_note",
    "created_at",
    "updated_at",
    "execution_authorized"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "software_name": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "behavior_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "forced_installation",
          "difficult_uninstall",
          "browser_hijacking",
          "ad_popup",
          "malicious_collection",
          "malicious_uninstall",
          "malicious_bundling",
          "other_user_rights_violation"
        ]
      }
    },
    "source_type": {
      "enum": [
        "public_regulatory_notice",
        "public_vendor_behavior_article",
        "synthetic_example",
        "official_vendor",
        "security_vendor",
        "curated_research",
        "community_report",
        "user_report",
        "synthetic_test"
      ]
    },
    "source_name": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri", "minLength": 1},
    "source_date": {"type": "string", "format": "date"},
    "evidence_summary": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "jurisdiction": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "false_positive_risk": {"enum": ["low", "medium", "high"]},
    "review_status": {
      "enum": [
        "draft",
        "needs_human_review",
        "approved_for_explanation",
        "deprecated",
        "rejected"
      ]
    },
    "license_note": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "execution_authorized": {"const": false}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc-cleanguard.example/schemas/reputation_match.schema.json",
  "title": "Evidence-only Reputation Match",
  "type": "object",
  "required": ["target_id", "target_type", "matched_record_id", "matched_name", "behavior_categories", "confidence", "false_positive_risk", "evidence", "review_status", "execution_authorized", "notes_for_ai"],
  "properties": {
    "target_id": {"type": "string", "minLength": 1},
    "target_type": {"enum": ["SOFTWARE", "STARTUP_ITEM", "SERVICE", "SCHEDULED_TASK", "UNKNOWN"]},
    "matched_record_id": {"type": "string", "minLength": 1},
    "matched_name": {"type": "string", "minLength": 1},
    "behavior_categories": {"type": "array", "items": {"enum": ["forced_installation", "difficult_uninstall", "browser_hijacking", "ad_popup", "malicious_collection", "malicious_uninstall", "malicious_bundling", "other_user_rights_violation"]}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "false_positive_risk": {"enum": ["low", "medium", "high"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source", "fact"], "properties": {"source": {"type": "string"}, "fact": {"type": "string"}}, "additionalProperties": false}},
    "review_status": {"enum": ["needs_human_review", "approved_for_explanation"]},
    "execution_authorized": {"const": false},
    "notes_for_ai": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

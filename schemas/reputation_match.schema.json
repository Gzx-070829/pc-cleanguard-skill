{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc-cleanguard.example/schemas/reputation_match.schema.json",
  "title": "Evidence-only Reputation Match",
  "type": "object",
  "required": ["target_id", "target_type", "matched_record_id", "matched_name", "behavior_categories", "confidence", "false_positive_risk", "evidence", "review_status", "execution_authorized", "notes_for_ai", "match_basis", "matched_indicator_type", "matched_indicator_value", "target_observed_value", "match_scope", "match_strength", "why_matched", "why_not_execution_authorization", "human_review_checklist", "guard_reason", "source_trace", "execution_gating_eligible"],
  "properties": {
    "target_id": {"type": "string", "minLength": 1},
    "target_type": {"enum": ["SOFTWARE", "STARTUP_ITEM", "SERVICE", "SCHEDULED_TASK", "UNKNOWN"]},
    "matched_record_id": {"type": "string", "minLength": 1},
    "matched_name": {"type": "string", "minLength": 1},
    "behavior_categories": {"type": "array", "items": {"enum": ["forced_installation", "difficult_uninstall", "browser_hijacking", "ad_popup", "malicious_collection", "malicious_uninstall", "malicious_bundling", "other_user_rights_violation"]}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "false_positive_risk": {"enum": ["low", "medium", "high"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source", "fact"], "properties": {"source": {"type": "string"}, "fact": {"type": "string"}}, "additionalProperties": false}},
    "review_status": {"enum": ["needs_human_review", "approved_for_explanation"]},
    "execution_authorized": {"const": false},
    "notes_for_ai": {"type": "string", "minLength": 1},
    "mapping_type": {"enum": ["direct_entity", "related_publisher", "name_collision_candidate", "analogical_behavior"]},
    "entity_scope": {"enum": ["windows_desktop_software", "mobile_app", "mobile_sdk", "browser_extension", "publisher_level", "unknown"]},
    "is_synthetic": {"type": "boolean"},
    "relation_confidence": {"enum": ["low", "medium", "high", "unknown"]},
    "analogy_basis": {"type": ["string", "null"]},
    "source_url": {"type": ["string", "null"]},
    "source_title": {"type": ["string", "null"]},
    "source_date": {"type": ["string", "null"]},
    "guard_reason": {"type": "array", "items": {"type": "string"}},
    "evidence_use": {"enum": ["explain_only", "review_hint", "publisher_level_warning", "name_collision_warning", "blocked_from_execution"]}
    ,"match_basis": {"enum": ["direct_name", "alias", "normalized_name", "publisher_assisted", "evidence_indicator", "behavior_context", "name_collision", "no_match"]}
    ,"matched_indicator_type": {"type": ["string", "null"]}
    ,"matched_indicator_value": {"type": ["string", "null"]}
    ,"target_observed_value": {"type": "string"}
    ,"match_scope": {"enum": ["installed_app", "startup_item", "service", "scheduled_task", "browser_extension", "file_observation", "publisher_level", "report_level"]}
    ,"match_strength": {"enum": ["exact", "strong", "medium", "weak", "informational"]}
    ,"why_matched": {"type": "string", "minLength": 1}
    ,"why_not_execution_authorization": {"type": "string", "minLength": 1}
    ,"human_review_checklist": {"type": "array", "items": {"type": "string"}}
    ,"source_trace": {"type": "object"}
    ,"execution_gating_eligible": {"const": false}
  },
  "additionalProperties": false
}

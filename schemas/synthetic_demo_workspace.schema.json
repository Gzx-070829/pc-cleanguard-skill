{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc-cleanguard.example/schemas/synthetic_demo_workspace.schema.json",
  "title": "PC CleanGuard Synthetic Demo Workspace",
  "type": "object",
  "required": [
    "workspace_id", "nonce", "created_by", "created_at", "synthetic_only",
    "expected_files", "file_hashes", "allowed_operations", "workspace_root"
  ],
  "properties": {
    "workspace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "nonce": {"type": "string", "minLength": 32},
    "created_by": {"const": "pc_cleanguard.demo.acceptance.v0.4.1"},
    "created_at": {"type": "string", "minLength": 1},
    "synthetic_only": {"const": true},
    "expected_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "file_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "allowed_operations": {"const": ["preview", "quarantine", "restore"]},
    "workspace_root": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

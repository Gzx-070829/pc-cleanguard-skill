{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc-cleanguard.example/schemas/skill_action_request.schema.json",
  "title": "PC CleanGuard Skill Action Request through PR21",
  "description": "A JSON request for analysis or explicitly confirmed reversible quarantine actions.",
  "type": "object",
  "required": ["action", "payload"],
  "properties": {
    "schema_version": {"const": "0.1", "default": "0.1"},
    "request_id": {"type": "string", "minLength": 1},
    "action": {
      "enum": [
        "scan_from_json",
        "explain_report",
        "build_cleanup_plan",
        "write_report",
        "write_audit",
        "recommend_external_tools",
        "quarantine_file",
        "list_quarantine_items",
        "restore_quarantine_item",
        "match_reputation",
        "build_pup_insight",
        "inspect_pup_risk",
        "build_pup_review_pack",
        "build_behavior_indicators",
        "validate_cn_evidence_pack",
        "validate_cn_source_matrix",
        "summarize_cn_source_matrix",
        "build_evidence_quality_summary",
        "validate_real_report_shape",
        "build_cn_win_pup_review_pack"
      ]
    },
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "scan_from_json"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["input_data"],
            "properties": {
              "input_data": {"type": "object"},
              "scan_id": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "explain_report"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["report"],
            "properties": {
              "report": {"type": "object"},
              "provider": {"enum": ["mock", "dry-run-prompt"]}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "build_cleanup_plan"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["report"],
            "properties": {
              "report": {"type": "object"},
              "plan_id": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "recommend_external_tools"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["catalog", "allowlisted_tool_ids"],
            "properties": {
              "cleanup_plan": {"type": "object"},
              "report_summary": {"type": "object"},
              "catalog": {
                "type": "object",
                "required": ["records"],
                "properties": {
                  "records": {
                    "type": "array",
                    "items": {"$ref": "external_tool.schema.json"}
                  }
                },
                "additionalProperties": false
              },
              "allowlisted_tool_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "governance_decisions": {
                "type": "array",
                "items": {"type": "object"}
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["source", "fact"],
                  "properties": {
                    "source": {"type": "string", "minLength": 1},
                    "fact": {"type": "string", "minLength": 1}
                  },
                  "additionalProperties": false
                }
              },
              "installed_apps": {
                "type": "array",
                "items": {"type": "object"}
              }
            },
            "oneOf": [
              {"required": ["cleanup_plan"], "not": {"required": ["report_summary"]}},
              {"required": ["report_summary"], "not": {"required": ["cleanup_plan"]}}
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "write_report"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["path", "report"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "report": {"type": "object"},
              "explicit_overwrite": {"type": "boolean", "default": false}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "write_audit"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["path", "events"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "events": {
                "type": "array",
                "items": {"type": "object"}
              },
              "explicit_overwrite": {"type": "boolean", "default": false}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"action": {"const": "quarantine_file"}}},
      "then": {"properties": {"payload": {
        "type": "object",
        "required": ["root", "path", "reason", "confirmed"],
        "properties": {
          "root": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "confirmed": {"const": true},
          "evidence": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": false
      }}}
    },
    {
      "if": {"properties": {"action": {"const": "list_quarantine_items"}}},
      "then": {"properties": {"payload": {
        "type": "object", "required": ["root"],
        "properties": {"root": {"type": "string", "minLength": 1}},
        "additionalProperties": false
      }}}
    },
    {
      "if": {"properties": {"action": {"const": "restore_quarantine_item"}}},
      "then": {"properties": {"payload": {
        "type": "object", "required": ["root", "item_id", "confirmed"],
        "properties": {
          "root": {"type": "string", "minLength": 1},
          "item_id": {"type": "string", "minLength": 1},
          "confirmed": {"const": true}
        },
        "additionalProperties": false
      }}}
    },
    {
      "if": {"properties": {"action": {"const": "match_reputation"}}},
      "then": {"properties": {"payload": {
        "type": "object", "required": ["report", "seed_path"],
        "properties": {"report": {"type": "object"}, "seed_path": {"type": "string", "minLength": 1}},
        "additionalProperties": false
      }}}
    },
    {
      "if": {"properties": {"action": {"const": "build_pup_insight"}}},
      "then": {"properties": {"payload": {
        "type": "object", "required": ["matches"],
        "properties": {"matches": {"type": "array", "items": {"type": "object"}}},
        "additionalProperties": false
      }}}
    },
    {
      "if": {"properties": {"action": {"const": "inspect_pup_risk"}}},
      "then": {"properties": {"payload": {
        "type": "object", "required": ["report", "seed_path"],
        "properties": {
          "report": {"type": "object"},
          "seed_path": {"type": "string", "minLength": 1},
          "evidence_pack": {"type": "boolean", "default": false},
          "include_indicators": {"type": "boolean", "default": false}
        },
        "additionalProperties": false
      }}}
    },
    {
      "if": {"properties": {"action": {"const": "build_pup_review_pack"}}},
      "then": {"properties": {"payload": {
        "type": "object",
        "required": ["report", "evidence_pack_path", "output_dir"],
        "properties": {
          "report": {"type": "object"},
          "evidence_pack_path": {"type": "string", "minLength": 1},
          "cn_evidence_pack_path": {"type": "string", "minLength": 1},
          "cn_source_matrix_path": {"type": "string", "minLength": 1},
          "cn_candidate_sources_path": {"type": "string", "minLength": 1},
          "include_behavior_indicators": {"type": "boolean", "default": false},
          "output_dir": {"type": "string", "minLength": 1},
          "overwrite": {"type": "boolean", "default": false}
        },
        "additionalProperties": false
      }}}
    },
    {
      "if": {"properties": {"action": {"const": "build_behavior_indicators"}}},
      "then": {"properties": {"payload": {
        "type": "object",
        "required": ["report"],
        "properties": {"report": {"type": "object"}},
        "additionalProperties": false
      }}}
    },
    {
      "if": {"properties": {"action": {"const": "validate_cn_evidence_pack"}}},
      "then": {"properties": {"payload": {
        "type": "object",
        "required": ["path"],
        "properties": {"path": {"type": "string", "minLength": 1}},
        "additionalProperties": false
      }}}
    },
    {
      "if": {"properties": {"action": {"enum": ["validate_cn_source_matrix", "summarize_cn_source_matrix"]}}},
      "then": {"properties": {"payload": {
        "type": "object",
        "required": ["path"],
        "properties": {"path": {"type": "string", "minLength": 1}},
        "additionalProperties": false
      }}}
    }
  ],
  "additionalProperties": false
}

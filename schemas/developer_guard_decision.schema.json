{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc-cleanguard.example/schemas/developer_guard_decision.schema.json",
  "title": "PC CleanGuard Developer Guard Decision",
  "description": "An explainable path-only protection decision. It never authorizes execution.",
  "type": "object",
  "required": [
    "path",
    "protected",
    "reason",
    "evidence",
    "protection_level",
    "matched_rule",
    "execution_authorized"
  ],
  "properties": {
    "path": {"type": "string", "minLength": 1},
    "protected": {"type": "boolean"},
    "reason": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "fact"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "fact": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "protection_level": {
      "enum": [
        "PROTECTION_LEVEL_BLOCK_DEVELOPER_ASSET",
        "PROTECTION_LEVEL_NONE"
      ]
    },
    "matched_rule": {"type": ["string", "null"]},
    "execution_authorized": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"protected": {"const": true}}},
      "then": {
        "properties": {
          "protection_level": {"const": "PROTECTION_LEVEL_BLOCK_DEVELOPER_ASSET"},
          "matched_rule": {"type": "string", "minLength": 1}
        }
      },
      "else": {
        "properties": {
          "protection_level": {"const": "PROTECTION_LEVEL_NONE"},
          "matched_rule": {"const": null}
        }
      }
    }
  ],
  "additionalProperties": false
}

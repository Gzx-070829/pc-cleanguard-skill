{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc-cleanguard.example/schemas/external_tool_invocation_plan.schema.json",
  "title": "PC CleanGuard External Tool Invocation Plan",
  "description": "A Level 0 plan-only review artifact. It has no command and cannot authorize tool execution.",
  "type": "object",
  "required": [
    "plan_id",
    "tool_id",
    "tool_name",
    "tool_type",
    "requested_action",
    "risk_level",
    "evidence",
    "reason",
    "required_user_confirmation",
    "execution_level",
    "blocked_if_untrusted",
    "blocked",
    "trusted",
    "mode",
    "execution_authorized"
  ],
  "properties": {
    "plan_id": {"type": "string", "minLength": 1},
    "tool_id": {"type": "string", "minLength": 1},
    "tool_name": {"type": "string", "minLength": 1},
    "tool_type": {
      "enum": [
        "official_uninstaller",
        "winget",
        "vendor_cleanup_tool",
        "trusted_third_party_uninstaller"
      ]
    },
    "requested_action": {"type": "string", "minLength": 1},
    "risk_level": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "fact"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "fact": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "reason": {"type": "string", "minLength": 1},
    "required_user_confirmation": {"const": true},
    "execution_level": {"const": "LEVEL_0_READ_ONLY"},
    "blocked_if_untrusted": {"const": true},
    "blocked": {"type": "boolean"},
    "trusted": {"type": "boolean"},
    "mode": {"const": "plan_only"},
    "execution_authorized": {"const": false}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc-cleanguard.example/schemas/reputation_result.schema.json",
  "title": "PC CleanGuard Reputation Result",
  "type": "object",
  "required": ["target_id", "sources", "confidence", "conflicts", "freshness", "privacy_mode", "consent_required", "final_reputation_summary"],
  "properties": {
    "target_id": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "items": {"type": "object", "required": ["name", "verdict"], "properties": {"name": {"type": "string", "minLength": 1}, "verdict": {"type": "string", "minLength": 1}, "observed_at": {"type": ["string", "null"], "format": "date-time"}}, "additionalProperties": false}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "freshness": {"type": "string", "minLength": 1},
    "privacy_mode": {"enum": ["offline", "metadata", "cloud_deep"]},
    "consent_required": {"type": "boolean"},
    "final_reputation_summary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

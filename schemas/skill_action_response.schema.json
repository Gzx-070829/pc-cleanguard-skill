{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc-cleanguard.example/schemas/skill_action_response.schema.json",
  "title": "PC CleanGuard Skill Action Response through PR21",
  "description": "A Level 0 analysis or Level 2 reversible-action result that grants no future execution authority.",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "action",
    "status",
    "requires_user_confirmation",
    "execution_level",
    "evidence",
    "execution_authorized",
    "result"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "request_id": {"type": "string", "minLength": 1},
    "action": {
      "enum": [
        "scan_from_json",
        "explain_report",
        "build_cleanup_plan",
        "write_report",
        "write_audit",
        "recommend_external_tools",
        "quarantine_file",
        "list_quarantine_items",
        "restore_quarantine_item",
        "match_reputation",
        "build_pup_insight",
        "inspect_pup_risk",
        "build_pup_review_pack",
        "build_behavior_indicators",
        "validate_cn_evidence_pack",
        "validate_cn_source_matrix",
        "summarize_cn_source_matrix"
      ]
    },
    "status": {"enum": ["completed", "planned"]},
    "requires_user_confirmation": {"type": "boolean"},
    "execution_level": {"enum": ["LEVEL_0_READ_ONLY", "LEVEL_2_REVERSIBLE"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "fact"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "fact": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "execution_authorized": {"const": false},
    "result": {"type": "object"}
  },
  "additionalProperties": false
}

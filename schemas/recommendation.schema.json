{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc-cleanguard.example/schemas/recommendation.schema.json",
  "title": "PC CleanGuard Recommendation",
  "type": "object",
  "required": ["recommendation_id", "target", "classification", "risk_level", "recommendation", "evidence_chain", "why_not_more_aggressive", "auto_execution", "required_confirmation", "rollback_available"],
  "properties": {
    "recommendation_id": {"type": "string", "minLength": 1},
    "target": {"type": "object", "required": ["target_id", "name"], "properties": {"target_id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "classification": {"enum": ["KEEP", "ASK_USER", "SAFE_REMOVE", "STARTUP_OFF", "QUARANTINE", "BLOCK"]},
    "risk_level": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "recommendation": {"type": "string", "minLength": 1},
    "evidence_chain": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source", "fact"], "properties": {"source": {"type": "string", "minLength": 1}, "fact": {"type": "string", "minLength": 1}, "reference": {"type": ["string", "null"]}}, "additionalProperties": false}},
    "why_not_more_aggressive": {"type": "string", "minLength": 1},
    "auto_execution": {"const": false},
    "required_confirmation": {"type": "boolean"},
    "rollback_available": {"type": "boolean"}
  },
  "additionalProperties": false
}
